{
  "manifest_version": 3,
  "name": "Video to Notes",
  "version": "2.0.0",
  "description": "Turns a video into organised notes with clickable timestamps. Works on YouTube and on any site whose video has captions. Ask questions, read the transcript, send notes to Notion.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "sidePanel", "scripting", "activeTab", "contextMenus", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Video to Notes" },
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Open the notes panel" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["launcher.js"],
      "css": ["launcher.css"],
      "run_at": "document_idle"
    }
  ]
}
